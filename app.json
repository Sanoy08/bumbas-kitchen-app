{
  "expo": {
    "name": "Bumba's Kitchen",
    "slug": "bumbas-kitchen",
    "version": "1.0.50",
    "orientation": "portrait",
    "icon": "./assets/images/app-logo.png",
    "scheme": "bumbaskitchenapp",
    "userInterfaceStyle": "automatic",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/40acdafb-c0f4-4185-a987-1f04ce8c59d8"
    },
    "ios": {
      "icon": "./assets/images/app-logo.png",
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Allow $(PRODUCT_NAME) to use speech recognition.",
        "NSMicrophoneUsageDescription": "Allow $(PRODUCT_NAME) to use the microphone."
      }
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "REQUEST_INSTALL_PACKAGES",
        "RECORD_AUDIO",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "predictiveBackGestureEnabled": false,
      "package": "com.bumbaskitchen.app",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/app-logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#e11d48",
          "image": "./assets/images/LOGO.png"
        }
      ],
      "expo-status-bar",
      "expo-secure-store",
      "expo-image",
      "expo-font",
      "@react-native-community/datetimepicker",
      "expo-notifications",
      "expo-speech-recognition",
      "@maplibre/maplibre-react-native",
      "expo-sharing",
      "expo-web-browser",
      "expo-audio"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "40acdafb-c0f4-4185-a987-1f04ce8c59d8"
      }
    },
    "owner": "sanoy08"
  }
}